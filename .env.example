# Opik Cloud: https://www.comet.com/opik/api
# Self-hosted: https://opik.example.com/api
OPIK_URL=https://www.comet.com/opik/api
OPIK_API_KEY=
OPIK_WORKSPACE=

# US: https://api.braintrust.dev
# EU: https://api-eu.braintrust.dev
# Self-hosted: your Braintrust API URL
BRAINTRUST_URL=https://api.braintrust.dev
# Required for prompts, scorers, online evals, review scores, annotation queues, dashboards, and dataset/experiment object tags; bt profiles only cover row uploads.
BRAINTRUST_API_KEY=

# Prompt migration defaults to the latest Opik version. Set to all to replay history.
OPIK_TO_BT_PROMPT_HISTORY=latest
